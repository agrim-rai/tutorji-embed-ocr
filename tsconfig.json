{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "src/app/api/ocr-get/route.js", "src/app/ada-tester/page.jsx", "src/app/api/verify-oder/route.js", "src/app/apisrc/app/api/compare-images/oldroute.js/apisrc/app/api/compare-images/route.js", "src/app/api/verify-payment/route.js", "src/app/test-combiner/page.jsx", "src/app/api/vectors/route.js", "src/app/api/auth/status.js"],
  "exclude": ["node_modules"]
}
